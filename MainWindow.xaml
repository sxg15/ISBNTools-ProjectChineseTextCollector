<Window x:Class="ProjectChineseTextCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目中文文本采集工具"
        Width="1280"
        Height="780"
        MinWidth="1060"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D6DCE5" BorderThickness="1" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Text="Unity 项目" />
                <TextBox x:Name="ProjectPathTextBox"
                         Grid.Column="1"
                         Height="30"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="2"
                        Width="88"
                        Margin="10,0,0,0"
                        Click="BrowseProjectButton_Click"
                        Content="选择..." />
                <Button x:Name="ScanButton"
                        Grid.Column="3"
                        Width="96"
                        Margin="10,0,0,0"
                        Click="ScanButton_Click"
                        Content="开始扫描" />
                <Button x:Name="ExportButton"
                        Grid.Column="4"
                        Width="96"
                        Margin="10,0,0,0"
                        Click="ExportButton_Click"
                        Content="导出 Excel"
                        IsEnabled="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="IncludeThirdPartyCheckBox"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Content="包含第三方/示例目录" />
            <TextBlock Grid.Column="1"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       Text="搜索" />
            <TextBox x:Name="SearchTextBox"
                      Grid.Column="2"
                      Width="260"
                      Height="30"
                     Margin="8,0,0,0"
                     VerticalContentAlignment="Center"
                     TextChanged="Filter_Changed" />
            <TextBlock x:Name="SummaryTextBlock"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Foreground="#3F4754" />
        </Grid>

        <TabControl x:Name="ResultsTabControl"
                    Grid.Row="2"
                    SelectionChanged="ResultsTabControl_SelectionChanged" />

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="#D6DCE5"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#3F4754"
                           Text="请选择 Unity 项目后开始扫描。" />
                <TextBlock x:Name="ProgressPercentTextBlock"
                           Grid.Row="0"
                           Grid.Column="1"
                           MinWidth="72"
                           TextAlignment="Right"
                           FontWeight="SemiBold"
                           Foreground="#1F4E79"
                           Text="0%" />

                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Row="1"
                             Grid.Column="0"
                             Height="16"
                             Margin="0,8,12,0"
                             Minimum="0"
                             Maximum="100" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressFileTextBlock"
                               MinWidth="94"
                               Foreground="#3F4754"
                               Text="文件 0/0" />
                    <TextBlock x:Name="ProgressRecordTextBlock"
                               Margin="10,0,0,0"
                               Foreground="#3F4754"
                               Text="结果 0" />
                </StackPanel>

                <TextBlock x:Name="CurrentFileTextBlock"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,6,0,0"
                           Foreground="#6B7280"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
